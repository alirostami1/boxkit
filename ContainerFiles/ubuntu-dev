FROM quay.io/toolbx/ubuntu-toolbox:25.04

LABEL com.github.containers.toolbox="true" \
      usage="This image is meant to be used with the toolbox or distrobox command" \
      summary="Ubuntu dev base image" \
      maintainer="contact@alirostami.net"

# Configure a non-root user that matches the host UID/GID when provided.
ARG USERNAME=aros
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid "${USER_GID}" "${USERNAME}" \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" -m "${USERNAME}" \
    && usermod -aG sudo "${USERNAME}" \
    && printf "%%sudo ALL=(ALL) NOPASSWD: ALL\n" > /etc/sudoers.d/99-sudo-nopasswd \
    && chmod 0440 /etc/sudoers.d/99-sudo-nopasswd

# Copy the setup scripts and package list into the user's home.
COPY --chown=${USERNAME}:${USERNAME} ../scripts/ubuntu-dev.sh /home/${USERNAME}/ubuntu-dev.sh
COPY --chown=${USERNAME}:${USERNAME} ../packages/ubuntu-dev.packages /home/${USERNAME}/ubuntu-dev.packages
COPY --chown=${USERNAME}:${USERNAME} ../dot_config/base-dev/ /home/${USERNAME}/

USER ${USERNAME}
WORKDIR /home/${USERNAME}
ENV NPM_CONFIG_PREFIX=/home/${USERNAME}/.npm-global
ENV PATH=/home/${USERNAME}/.npm-global/bin:/home/${USERNAME}/.local/bin:${PATH}

# Run the setup scripts
RUN chmod +x ubuntu-dev.sh && ./ubuntu-dev.sh && rm -f ubuntu-dev.sh ubuntu-dev.packages
